{
  "expo": {
    "name": "OfflineMate",
    "slug": "offlinemate",
    "scheme": "offlinemate",
    "version": "0.10.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#030712"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#1d4ed8",
          "sounds": [
            "./assets/sounds/reminder_tone.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "OfflineMate uses your calendar to answer scheduling requests.",
          "remindersPermission": "OfflineMate uses reminders to help with tasks."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "OfflineMate needs contacts access for contact-related commands."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/with-cmake-object-path-max",
      "./plugins/with-native-debug-symbols"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.offlinemate.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.offlinemate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.offlinemate.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OfflineMate uses microphone access for voice assistant features.",
        "NSAlarmKitUsageDescription": "OfflineMate sets alarms you ask for, so they ring even in silent mode or Focus."
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb401217-1019-4b74-b72d-18b4574b8595"
      }
    },
    "owner": "razasaleemi",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
