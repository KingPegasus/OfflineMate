{
  "name": "offline-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "OfflineMate is a privacy-first, context-aware mobile assistant built with Expo and React Native.\r The app is designed to run fully on-device (LLM, retrieval, speech, and tools) and support a wide\r range of phones from low-end to flagship devices through adaptive model tiers.",
  "main": "expo-router/entry",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "validate": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:perf && npm run audit:ci",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:perf": "vitest run tests/perf",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "vitest run --coverage tests/unit tests/integration tests/e2e",
    "android:logs": "adb logcat -s ReactNativeJS:V ReactNative:V Expo:V",
    "android:logs:all": "adb logcat",
    "android:logs:raw": "adb logcat *:V",
    "website:build": "node scripts/minify-website.mjs",
    "search:live": "tsx scripts/run-web-search.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.20.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@tanstack/react-query": "^5.104.3",
    "buffer": "^6.0.3",
    "chrono-node": "^2.9.1",
    "expo": "~58.0.21",
    "expo-alarm": "^0.2.2",
    "expo-asset": "~58.0.19",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-contacts": "~58.0.10",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-device-info": "^15.0.2",
    "react-native-executorch": "^0.11.0",
    "react-native-executorch-expo-resource-fetcher": "^0.11.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "whisper.rn": "^0.7.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "audit-ci": "^7.1.0",
    "babel-preset-expo": "~58.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
